APP_ENV=dev
DATABASE_URL=postgresql+psycopg://ledgerline:ledgerline@localhost:5432/ledgerline

# PayPal sandbox app credentials (developer.paypal.com -> Apps & Credentials)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the dashboard; without it signatures are NOT verified (dev only)
PAYPAL_WEBHOOK_ID=

# Executor: true = record the PayPal call instead of sending it (fixture demos, judges without sandbox)
PAYPAL_DRY_RUN=false
# Agent tool source: PayPal's official MCP server via node (backend/node_modules/@paypal/mcp). Needs Node 18+.
PAYPAL_MCP_ENABLED=true

# LLM for agents. LangChain "provider:model". Use "stub" to run deterministic agents with no API key.
LLM_MODEL=anthropic:claude-sonnet-4-5
# Key for whichever provider LLM_MODEL names (exported as ANTHROPIC_API_KEY / OPENAI_API_KEY / AZURE_OPENAI_API_KEY).
# Tip: create a provider key named "ledgerline" so usage is tracked per project in the provider console.
LLM_API_KEY=
# Azure OpenAI additionally needs: AZURE_OPENAI_ENDPOINT=  OPENAI_API_VERSION=
